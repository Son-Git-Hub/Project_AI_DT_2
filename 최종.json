    {
      "parameters": {
        "html": "<!doctype html>\n<html lang=\"ko\">\n  <body style=\"font-family:system-ui,-apple-system,Segoe UI,Roboto,Apple SD Gothic Neo,Malgun Gothic,Helvetica,Arial,sans-serif; background:#f6f8fa; padding:24px\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:900px;margin:0 auto;background:#fff;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden\">\n      <tr><td style=\"padding:24px\">\n        <div style=\"font-size:18px;font-weight:700;margin-bottom:8px\">📊 일일 리포트 ({{ new Date().toISOString().slice(0,10) }} 기준)</div>\n        <div style=\"font-size:13px;color:#6b7280;margin-bottom:16px\">자동 생성된 HTML 리포트</div>\n\n        <div style=\"overflow:auto\">\n          <table cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;min-width:600px;width:100%\">\n            <thead>\n              <tr>\n                <th style=\"text-align:left;padding:8px;border-bottom:1px solid #e5e7eb\">충전소명</th>\n                <th style=\"text-align:left;padding:8px;border-bottom:1px solid #e5e7eb\">주소</th>\n                <th style=\"text-align:left;padding:8px;border-bottom:1px solid #e5e7eb\">상태</th>\n                <th style=\"text-align:left;padding:8px;border-bottom:1px solid #e5e7eb\">출력(kW)</th>\n              </tr>\n            </thead>\n            <tbody>\n              {{\n                // 입력 아이템 모두\n                (function () {\n                  const arr = $input.all();\n                  if (!arr.length) {\n                    return '<tr><td colspan=\"4\" style=\"padding:12px;color:#6b7280\">표시할 데이터가 없습니다.</td></tr>';\n                  }\n                  return arr.map(function(it){\n                    const j = it.json;\n                    return '<tr>'\n                      + '<td style=\"padding:8px;border-bottom:1px solid #f1f5f9\">' + (j.statNm  ?? '') + '</td>'\n                      + '<td style=\"padding:8px;border-bottom:1px solid #f1f5f9\">' + (j.addr    ?? '') + '</td>'\n                      + '<td style=\"padding:8px;border-bottom:1px solid #f1f5f9\">' + (j.stat    ?? '') + '</td>'\n                      + '<td style=\"padding:8px;border-bottom:1px solid #f1f5f9\">' + (j.output  ?? '') + '</td>'\n                      + '</tr>';\n                  }).join('');\n                })()\n              }}\n            </tbody>\n          </table>\n        </div>\n      </td></tr>\n    </table>\n  </body>\n</html>\n"
      },
      "type": "n8n-nodes-base.html",
