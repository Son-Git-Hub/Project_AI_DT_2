    },
    {
      "parameters": {
        "html": "<!doctype html>\n<html lang=\"ko\">\n  <body style=\"font-family:system-ui,-apple-system,Segoe UI,Roboto,Apple SD Gothic Neo,Malgun Gothic,Helvetica,Arial,sans-serif; background:#f6f8fa; padding:24px\">\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:1200px;margin:0 auto;background:#fff;border:1px solid #e5e7eb;border-radius:12px;overflow:hidden\">\n      <tr><td style=\"padding:24px\">\n        <div style=\"font-size:18px;font-weight:700;margin-bottom:8px\">📊 일일 리포트 ({{ new Date().toISOString().slice(0,10) }} 기준)</div>\n        <div style=\"font-size:13px;color:#6b7280;margin-bottom:16px\">자동 생성된 HTML 리포트</div>\n\n        <div style=\"overflow:auto\">\n          <table cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;min-width:900px;width:100%\">\n            <thead>\n              <tr>\n                <th style=\"text-align:left;padding:8px;border-bottom:1px solid #e5e7eb;width:160px\">충전소명</th>\n                <th style=\"text-align:left;padding:8px;border-bottom:1px solid #e5e7eb;width:260px\">주소</th>\n                <th style=\"text-align:left;padding:8px;border-bottom:1px solid #e5e7eb;width:120px\">상태</th>\n                <th style=\"text-align:left;padding:8px;border-bottom:1px solid #e5e7eb;width:80px\">출력(kW)</th>\n                <th style=\"text-align:left;padding:8px;border-bottom:1px solid #e5e7eb;width:70px\">무료주차</th>\n                <th style=\"text-align:left;padding:8px;border-bottom:1px solid #e5e7eb;width:160px\">갱신시각</th>\n                <th style=\"text-align:left;padding:8px;border-bottom:1px solid #e5e7eb;width:100px\">운영기관</th>\n                <th style=\"text-align:left;padding:8px;border-bottom:1px solid #e5e7eb;width:140px\">이용시간</th>\n                <th style=\"text-align:left;padding:8px;border-bottom:1px solid #e5e7eb;width:140px\">문의전화</th>\n              </tr>\n            </thead>\n            <tbody>\n              {{\n                (function () {\n                  const fmtTS = (ts) => {\n                    if (!ts) return '';\n                    const s = String(ts).padEnd(14,'0');\n                    const y=s.slice(0,4), m=s.slice(4,6), d=s.slice(6,8),\n                          hh=s.slice(8,10), mm=s.slice(10,12), ss=s.slice(12,14);\n                    return `${y}-${m}-${d} ${hh}:${mm}:${ss}`;\n                  };\n\n                  const rows = $input.all();\n                  if (!rows.length) {\n                    return '<tr><td colspan=\"9\" style=\"padding:12px;color:#6b7280\">표시할 데이터가 없습니다.</td></tr>';\n                  }\n\n                  return rows.map((it) => {\n                    const j = it.json || {};\n                    const statText = (j.stat === \"2\") ? \"충전 가능\" : (j.stat ?? \"\");\n                    return '<tr>'\n                      + '<td style=\"padding:8px;border-bottom:1px solid #f1f5f9;word-break:keep-all\">' + (j.statNm      ?? '') + '</td>'\n                      + '<td style=\"padding:8px;border-bottom:1px solid #f1f5f9\">' + (j.addr        ?? '') + '</td>'\n                      + '<td style=\"padding:8px;border-bottom:1px solid #f1f5f9\">' + statText + '</td>'\n                      + '<td style=\"padding:8px;border-bottom:1px solid #f1f5f9\">' + (j.output      ?? '') + '</td>'\n                      + '<td style=\"padding:8px;border-bottom:1px solid #f1f5f9\">' + (j.parkingFree ?? '') + '</td>'\n                      + '<td style=\"padding:8px;border-bottom:1px solid #f1f5f9\">' + fmtTS(j.statUpdDt) + '</td>'\n                      + '<td style=\"padding:8px;border-bottom:1px solid #f1f5f9\">' + (j.bnm         ?? '') + '</td>'\n                      + '<td style=\"padding:8px;border-bottom:1px solid #f1f5f9\">' + (j.useTime     ?? '') + '</td>'\n                      + '<td style=\"padding:8px;border-bottom:1px solid #f1f5f9\">' + (j.busiCall    ?? '') + '</td>'\n                      + '</tr>';\n                  }).join('');\n                })()\n              }}\n            </tbody>\n          </table>\n        </div>\n      </td></tr>\n    </table>\n  </body>\n</html>\n"
      },
